<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Private.CoreLib">
    <!-- Dark Classic: dark panels, blue accent, light text -->
    <Color x:Key="AccentColor">#4E8FD8</Color>
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>

    <SolidColorBrush x:Key="WindowBack" Color="#23272E"/>
    <SolidColorBrush x:Key="PanelBack" Color="#1D2126"/>
    <SolidColorBrush x:Key="ListBack" Color="#171A1F"/>
    <SolidColorBrush x:Key="InputBack" Color="#12151A"/>
    <SolidColorBrush x:Key="StatusBack" Color="#1A1E24"/>

    <SolidColorBrush x:Key="Text" Color="#DDE3EC"/>
    <SolidColorBrush x:Key="TextDim" Color="#8B96A5"/>
    <SolidColorBrush x:Key="SelectionText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#7FB2F0"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SelectionBack" Color="#2F5D8F"/>
    <SolidColorBrush x:Key="HoverBack" Color="#2C333D"/>
    <SolidColorBrush x:Key="HeaderBack" Color="#262B33"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3C4552"/>

    <LinearGradientBrush x:Key="BtnBack" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#49566A" Offset="0"/>
        <GradientStop Color="#3B485A" Offset="0.5"/>
        <GradientStop Color="#2E3846" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BtnHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5A6A82" Offset="0"/>
        <GradientStop Color="#48566C" Offset="0.5"/>
        <GradientStop Color="#3A4656" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BtnPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#242C38" Offset="0"/>
        <GradientStop Color="#36404E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BtnBorder" Color="#141920"/>
    <SolidColorBrush x:Key="Glyph" Color="#E8EEF7"/>

    <SolidColorBrush x:Key="DisplayBack" Color="#0C1015"/>
    <SolidColorBrush x:Key="DisplayBar" Color="#E8EEF7"/>
    <SolidColorBrush x:Key="DisplayPeak" Color="#7FB2F0"/>
    <SolidColorBrush x:Key="BufferFill" Color="#4CAF50"/>
    <SolidColorBrush x:Key="RecBrush" Color="#E23A3A"/>
</ResourceDictionary>
