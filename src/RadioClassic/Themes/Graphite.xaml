<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Private.CoreLib">
    <!-- Graphite: very dark, monochrome with amber accent -->
    <Color x:Key="AccentColor">#D8963C</Color>
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>

    <SolidColorBrush x:Key="WindowBack" Color="#1B1B1D"/>
    <SolidColorBrush x:Key="PanelBack" Color="#171719"/>
    <SolidColorBrush x:Key="ListBack" Color="#121214"/>
    <SolidColorBrush x:Key="InputBack" Color="#0E0E10"/>
    <SolidColorBrush x:Key="StatusBack" Color="#151517"/>

    <SolidColorBrush x:Key="Text" Color="#D8D8DA"/>
    <SolidColorBrush x:Key="TextDim" Color="#86868C"/>
    <SolidColorBrush x:Key="SelectionText" Color="#101010"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#E5AC54"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SelectionBack" Color="#B98234"/>
    <SolidColorBrush x:Key="HoverBack" Color="#2A2A2E"/>
    <SolidColorBrush x:Key="HeaderBack" Color="#222225"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A40"/>

    <LinearGradientBrush x:Key="BtnBack" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4C4C52" Offset="0"/>
        <GradientStop Color="#3A3A40" Offset="0.5"/>
        <GradientStop Color="#2E2E33" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BtnHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5E5E66" Offset="0"/>
        <GradientStop Color="#4A4A52" Offset="0.5"/>
        <GradientStop Color="#3C3C42" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BtnPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26262A" Offset="0"/>
        <GradientStop Color="#38383E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BtnBorder" Color="#0A0A0C"/>
    <SolidColorBrush x:Key="Glyph" Color="#EAEAEC"/>

    <SolidColorBrush x:Key="DisplayBack" Color="#0A0A0C"/>
    <SolidColorBrush x:Key="DisplayBar" Color="#E8E8EA"/>
    <SolidColorBrush x:Key="DisplayPeak" Color="#E5AC54"/>
    <SolidColorBrush x:Key="BufferFill" Color="#62A562"/>
    <SolidColorBrush x:Key="RecBrush" Color="#E23A3A"/>
</ResourceDictionary>
