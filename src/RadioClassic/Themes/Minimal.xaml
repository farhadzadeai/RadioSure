<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Minimal: flat, almost monochrome, very quiet -->
    <Color x:Key="AccentColor">#3E6CA6</Color>

    <SolidColorBrush x:Key="WindowBack" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="PanelBack" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ListBack" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBack" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatusBack" Color="#E8E8E8"/>

    <SolidColorBrush x:Key="Text" Color="#222222"/>
    <SolidColorBrush x:Key="TextDim" Color="#777777"/>
    <SolidColorBrush x:Key="SelectionText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#3E6CA6"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SelectionBack" Color="#3E6CA6"/>
    <SolidColorBrush x:Key="HoverBack" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="HeaderBack" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#C4C4C4"/>

    <SolidColorBrush x:Key="BtnBack" Color="#585858"/>
    <SolidColorBrush x:Key="BtnHover" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="BtnPressed" Color="#484848"/>
    <SolidColorBrush x:Key="BtnBorder" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Glyph" Color="#F4F4F4"/>

    <SolidColorBrush x:Key="DisplayBack" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DisplayBar" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="DisplayPeak" Color="#8FB2DF"/>
    <SolidColorBrush x:Key="BufferFill" Color="#5C9E5C"/>
    <SolidColorBrush x:Key="RecBrush" Color="#D83A3A"/>
</ResourceDictionary>
