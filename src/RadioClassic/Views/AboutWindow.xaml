<Window x:Class="RadioClassic.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Abt.Title}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBack}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource AppFontSize}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Image Source="/Assets/app.png" Width="48" Height="48" Margin="0,0,10,0" DockPanel.Dock="Left"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RadioClassic" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" Style="{DynamicResource DimText}"/>
                <TextBlock Text="{DynamicResource Abt.Tagline}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" x:Name="CreditsText" TextWrapping="Wrap" Style="{DynamicResource DimText}" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RbLink" Content="radio-browser.info" Click="OnRbLink" Margin="0,0,6,0" Padding="8,2"/>
            <Button Content="{DynamicResource Close}" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
