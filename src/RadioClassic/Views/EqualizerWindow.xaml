<Window x:Class="RadioClassic.Views.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Eq.Title}" Width="430" Height="290" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBack}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource AppFontSize}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,6">
            <CheckBox x:Name="EnabledBox" Content="{DynamicResource Eq.Enabled}" VerticalAlignment="Center"
                      Checked="OnAnyChange" Unchecked="OnAnyChange"/>
            <Button Content="{DynamicResource Eq.Reset}" DockPanel.Dock="Right" Click="OnReset" MinWidth="60" Margin="6,0,0,0"/>
            <Button Content="{DynamicResource Eq.SavePreset}" DockPanel.Dock="Right" Click="OnSavePreset" MinWidth="100" Margin="6,0,0,0"/>
            <ComboBox x:Name="PresetCombo" Width="120" HorizontalAlignment="Right" SelectionChanged="OnPresetChanged"
                      ToolTip="{DynamicResource Eq.Preset}"/>
        </DockPanel>

        <!-- 10 bands -->
        <Grid x:Name="BandsGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        </Grid>

        <!-- bass / treble / preamp / balance -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Eq.Bass}" Style="{DynamicResource DimText}" FontSize="10" HorizontalAlignment="Center"/>
            <Slider x:Name="BassSlider" Grid.Row="1" Minimum="-12" Maximum="12" TickFrequency="1" ValueChanged="OnAnyChange" Margin="4,0"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource Eq.Treble}" Style="{DynamicResource DimText}" FontSize="10" HorizontalAlignment="Center"/>
            <Slider x:Name="TrebleSlider" Grid.Row="1" Grid.Column="1" Minimum="-12" Maximum="12" TickFrequency="1" ValueChanged="OnAnyChange" Margin="4,0"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource Eq.Preamp}" Style="{DynamicResource DimText}" FontSize="10" HorizontalAlignment="Center"/>
            <Slider x:Name="PreampSlider" Grid.Row="1" Grid.Column="2" Minimum="-12" Maximum="12" TickFrequency="1" ValueChanged="OnAnyChange" Margin="4,0"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource Eq.Balance}" Style="{DynamicResource DimText}" FontSize="10" HorizontalAlignment="Center"/>
            <Slider x:Name="BalanceSlider" Grid.Row="1" Grid.Column="3" Minimum="-10" Maximum="10" TickFrequency="1" ValueChanged="OnAnyChange" Margin="4,0"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource Eq.DeletePreset}" Click="OnDeletePreset" Margin="0,0,6,0" MinWidth="100"/>
            <Button Content="{DynamicResource Close}" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
