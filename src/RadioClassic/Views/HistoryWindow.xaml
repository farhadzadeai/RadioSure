<Window x:Class="RadioClassic.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Hist.Title}" Width="540" Height="400" MinWidth="400" MinHeight="250"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBack}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource AppFontSize}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView x:Name="List" Style="{DynamicResource ThemedListView}" MouseDoubleClick="OnDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="130" DisplayMemberBinding="{Binding PlayedAtDisplay}">
                        <GridViewColumnHeader Content="{DynamicResource Hist.When}"/>
                    </GridViewColumn>
                    <GridViewColumn Width="190" DisplayMemberBinding="{Binding StationName}">
                        <GridViewColumnHeader Content="{DynamicResource Col.Name}"/>
                    </GridViewColumn>
                    <GridViewColumn Width="*">
                        <GridViewColumnHeader Content="{DynamicResource Hist.Track}"/>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <Button Content="{DynamicResource Close}" IsCancel="True" DockPanel.Dock="Right" Click="OnClose" HorizontalAlignment="Right"/>
            <Button Content="{DynamicResource Hist.PlayStation}" Click="OnPlay" Margin="0,0,6,0" MinWidth="100" DockPanel.Dock="Right"/>
            <Button Content="{DynamicResource Hist.Clear}" Click="OnClear" HorizontalAlignment="Left"/>
        </DockPanel>
    </Grid>
</Window>
