<Window x:Class="RadioClassic.Views.RecordingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Rec.Title}" Width="640" Height="400" MinWidth="480" MinHeight="260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBack}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource AppFontSize}">
    <Grid Margin="6">
        <TabControl x:Name="Tabs">
            <!-- ==================== active ==================== -->
            <TabItem Header="{DynamicResource Rec.Active}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView x:Name="ActiveList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Rec.Station}" Width="140" DisplayMemberBinding="{Binding StationName}"/>
                                <GridViewColumn Header="{DynamicResource Rec.Track}" Width="170" DisplayMemberBinding="{Binding CurrentTrack}"/>
                                <GridViewColumn Header="{DynamicResource Rec.Status}" Width="90" DisplayMemberBinding="{Binding StatusDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Rec.Duration}" Width="60" DisplayMemberBinding="{Binding DurationDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Rec.Size}" Width="70" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Rec.Format}" Width="70" DisplayMemberBinding="{Binding EffectiveFormat}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="ActiveEmpty" Text="{DynamicResource Rec.NoneActive}" Style="{DynamicResource DimText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{DynamicResource Rec.Stop}" Click="OnStopSession" Margin="0,0,6,0"/>
                        <Button Content="{DynamicResource Rec.OpenFolder}" Click="OnOpenSessionFolder"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ==================== schedules ==================== -->
            <TabItem Header="{DynamicResource Rec.Schedules}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListView x:Name="ScheduleList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Rec.Station}" Width="150" DisplayMemberBinding="{Binding StationName}"/>
                                <GridViewColumn Header="{DynamicResource Sch.Date}" Width="130" DisplayMemberBinding="{Binding StartDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Sch.Duration}" Width="70" DisplayMemberBinding="{Binding DurationDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Sch.Repeat}" Width="80" DisplayMemberBinding="{Binding RepeatDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Enabled}" Width="60" DisplayMemberBinding="{Binding EnabledDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="ScheduleEmpty" Text="{DynamicResource Rec.NoneScheduled}" Style="{DynamicResource DimText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Sch.Add}" Click="OnAddSchedule" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Sch.Edit}" Click="OnEditSchedule" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Sch.Delete}" Click="OnDeleteSchedule"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================== history ==================== -->
            <TabItem Header="{DynamicResource Rec.History}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource Rec.SearchPrompt}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="SearchBox" Width="180" TextChanged="OnSearchChanged" DockPanel.Dock="Left"/>
                    </DockPanel>
                    <ListView x:Name="HistoryList" Grid.Row="1" MouseDoubleClick="OnHistoryDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Rec.Station}" Width="120" DisplayMemberBinding="{Binding StationName}"/>
                                <GridViewColumn Header="{DynamicResource Rec.Track}" Width="150" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="{DynamicResource Rec.File}" Width="140" DisplayMemberBinding="{Binding FileName}"/>
                                <GridViewColumn Header="{DynamicResource Rec.Started}" Width="105" DisplayMemberBinding="{Binding StartedDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Rec.Duration}" Width="60" DisplayMemberBinding="{Binding DurationDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Rec.Size}" Width="60" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="{DynamicResource Rec.Status}" Width="70" DisplayMemberBinding="{Binding StatusDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="HistoryEmpty" Text="{DynamicResource Rec.NoneYet}" Style="{DynamicResource DimText}" Grid.Row="1"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="{DynamicResource Rec.OpenFolder}" Click="OnOpenEntryFolder" Margin="0,0,6,0"/>
                        <Button Content="{DynamicResource Rec.Rename}" Click="OnRenameEntry" Margin="0,0,6,0"/>
                        <Button Content="{DynamicResource Rec.DeleteFile}" Click="OnDeleteEntry" Margin="0,0,6,0"/>
                        <Button Content="{DynamicResource Rec.ExportList}" Click="OnExportList"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
