<Window x:Class="RadioClassic.Views.ScheduleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Sch.AddTitle}" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBack}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource AppFontSize}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource Sch.Station}" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock x:Name="StationText" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,6"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Text="{DynamicResource Sch.Date}" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <DatePicker x:Name="DatePicker" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Width="130" HorizontalAlignment="Left"/>

            <TextBlock Text="{DynamicResource Sch.Time}" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <TextBox x:Name="TimeBox" Grid.Row="2" Grid.Column="1" Width="60" HorizontalAlignment="Left" Margin="0,0,0,6" Text="20:00"/>

            <TextBlock Text="{DynamicResource Sch.Duration}" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <TextBox x:Name="DurationBox" Grid.Row="3" Grid.Column="1" Width="60" HorizontalAlignment="Left" Margin="0,0,0,6" Text="60"/>

            <TextBlock Text="{DynamicResource Sch.Repeat}" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <ComboBox x:Name="RepeatCombo" Grid.Row="4" Grid.Column="1" Width="130" HorizontalAlignment="Left" Margin="0,0,0,6"
                      SelectionChanged="OnRepeatChanged"/>

            <TextBlock Text="{DynamicResource Sch.Days}" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <WrapPanel x:Name="DaysPanel" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6">
                <CheckBox x:Name="DayMo" Content="{DynamicResource Day.Mo}" Margin="0,0,8,2"/>
                <CheckBox x:Name="DayTu" Content="{DynamicResource Day.Tu}" Margin="0,0,8,2"/>
                <CheckBox x:Name="DayWe" Content="{DynamicResource Day.We}" Margin="0,0,8,2"/>
                <CheckBox x:Name="DayTh" Content="{DynamicResource Day.Th}" Margin="0,0,8,2"/>
                <CheckBox x:Name="DayFr" Content="{DynamicResource Day.Fr}" Margin="0,0,8,2"/>
                <CheckBox x:Name="DaySa" Content="{DynamicResource Day.Sa}" Margin="0,0,8,2"/>
                <CheckBox x:Name="DaySu" Content="{DynamicResource Day.Su}" Margin="0,0,8,2"/>
            </WrapPanel>

            <CheckBox x:Name="EnabledBox" Grid.Row="6" Grid.Column="1" Content="{DynamicResource Enabled}" IsChecked="True"/>
        </Grid>

        <TextBlock Grid.Row="1" Text="{DynamicResource Sch.Note}" Style="{DynamicResource DimText}"
                   TextWrapping="Wrap" Margin="0,4,0,8"/>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{DynamicResource RecBrush}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="{DynamicResource OK}" IsDefault="True" Click="OnOk" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Cancel}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
