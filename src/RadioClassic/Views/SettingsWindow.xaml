<Window x:Class="RadioClassic.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Opt.Title}" Width="560" Height="430" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBack}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource AppFontSize}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="SectionList" Margin="0,0,8,0" SelectionChanged="OnSectionChanged"
                     Background="{DynamicResource ListBack}" BorderBrush="{DynamicResource BorderBrush}"/>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PagePanel"/>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{DynamicResource Opt.RestoreDefaults}" Click="OnRestoreDefaults"/>
            <TextBlock x:Name="HintText" Style="{DynamicResource DimText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button Content="{DynamicResource Close}" IsCancel="True" HorizontalAlignment="Right" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
