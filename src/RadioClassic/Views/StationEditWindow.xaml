<Window x:Class="RadioClassic.Views.StationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource St.AddTitle}" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBack}" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource AppFontSize}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource St.Name}" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource St.Url}" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <TextBox x:Name="UrlBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource St.Homepage}" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <TextBox x:Name="HomepageBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource St.Country}" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <TextBox x:Name="CountryBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource St.Language}" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <TextBox x:Name="LanguageBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"/>
            <TextBlock Text="{DynamicResource St.Genre}" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,0,6"/>
            <TextBox x:Name="GenreBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="{DynamicResource RecBrush}" TextWrapping="Wrap" Margin="0,4,0,4"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource OK}" IsDefault="True" Click="OnOk" Margin="0,0,6,0"/>
            <Button Content="{DynamicResource Cancel}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
